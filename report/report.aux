\newlabel{tab:honest}{{1}{3}{Honest-test $p$-values: maximum full-feature trajectory distance against the 100-shuffle null. Monet2$\leftrightarrow $Trippy never crosses the threshold in any area.\relax }{table.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A}Figures}{3}{appendix.A}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Cohort screening across the 14 MICrONS sessions.} Per-session maximum $|z|$ across five summary statistics (neuron count, median per-neuron activity, mean pupil diameter, mean treadmill speed, fraction of unknown trials). Coral bars cross the $|z|=2$ flag; session 7\_5 (white bar) sits comfortably below the threshold on every axis and was selected for the deep dive.\relax }}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:cohort}{{1}{3}{\textbf {Cohort screening across the 14 MICrONS sessions.} Per-session maximum $|z|$ across five summary statistics (neuron count, median per-neuron activity, mean pupil diameter, mean treadmill speed, fraction of unknown trials). Coral bars cross the $|z|=2$ flag; session 7\_5 (white bar) sits comfortably below the threshold on every axis and was selected for the deep dive.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Trial-averaged PSTH per stimulus class, per cortical area.} Mean population response averaged within each stimulus class and plotted against trial time, one panel per area (V1, AL, LM, RL). Trippy sits highest, Clip intermediate (with an onset transient in the first few frames), Monet2 lowest. Class identity is already encoded in the first moment of population activity, before any dimensionality reduction.\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:psth}{{2}{4}{\textbf {Trial-averaged PSTH per stimulus class, per cortical area.} Mean population response averaged within each stimulus class and plotted against trial time, one panel per area (V1, AL, LM, RL). Trippy sits highest, Clip intermediate (with an onset transient in the first few frames), Monet2 lowest. Class identity is already encoded in the first moment of population activity, before any dimensionality reduction.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two separability metrics across cortical areas (Exp.~1).} Left: balanced silhouette in the top three PCs, with per-area shuffle-null IQR overlaid as a grey vertical bar. Right: 5-fold cross-validated multinomial logistic regression accuracy on the full neuron matrix, with the 83.2\% majority baseline as the dashed reference. The two metrics disagree: silhouette hovers around zero in every area, classifier accuracy is at ceiling. The class signal is decodable but is not aligned with the high-variance axes PCA picks.\relax }}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:exp1-bars}{{3}{4}{\textbf {Two separability metrics across cortical areas (Exp.~1).} Left: balanced silhouette in the top three PCs, with per-area shuffle-null IQR overlaid as a grey vertical bar. Right: 5-fold cross-validated multinomial logistic regression accuracy on the full neuron matrix, with the 83.2\% majority baseline as the dashed reference. The two metrics disagree: silhouette hovers around zero in every area, classifier accuracy is at ceiling. The class signal is decodable but is not aligned with the high-variance axes PCA picks.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Trial-averaged PCA per area in PC1--PC2 (Exp.~1).} One panel per cortical area (V1 top-left, AL top-right, LM bottom-left, RL bottom-right). Coloured dots are individual trials; crosses mark class centroids. The three stimulus classes overlap heavily in the high-variance subspace in every area: PCA finds the directions of largest variance, but those directions are not the ones that separate the classes.\relax }}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:exp1-grid}{{4}{5}{\textbf {Trial-averaged PCA per area in PC1--PC2 (Exp.~1).} One panel per cortical area (V1 top-left, AL top-right, LM bottom-left, RL bottom-right). Coloured dots are individual trials; crosses mark class centroids. The three stimulus classes overlap heavily in the high-variance subspace in every area: PCA finds the directions of largest variance, but those directions are not the ones that separate the classes.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Trial-averaged trajectories in PC1--PC2 space, per area (Exp.~2).} Four panels (V1, AL, LM, RL): three stationary, non-overlapping clusters per area. The filled circle marks frame~0; the open circle marks the last frame. The frame-0 markers sit offset from each cluster's bulk, indicating a shared neutral starting point and a rapid jump to stimulus-specific regions of state space within the first few frames (the onset transient seen in Fig.~\ref {fig:psth}).\relax }}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pc-clusters}{{5}{6}{\textbf {Trial-averaged trajectories in PC1--PC2 space, per area (Exp.~2).} Four panels (V1, AL, LM, RL): three stationary, non-overlapping clusters per area. The filled circle marks frame~0; the open circle marks the last frame. The frame-0 markers sit offset from each cluster's bulk, indicating a shared neutral starting point and a rapid jump to stimulus-specific regions of state space within the first few frames (the onset transient seen in Fig.~\ref {fig:psth}).\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {V1 pairwise distance time courses: biased vs honest (Exp.~2).} Left panel: distances computed in the full neuron space (the honest test). Right panel: distances computed in the top-3 PC subspace fit on real-label trial averages (the biased test). Solid lines are observed pairwise distances per frame; shaded bands are bootstrap envelopes (B=1000); dashed horizontals are the 95\textsuperscript  {th} percentile of the 100-shuffle null max distance per pair. The biased test puts every pair above its null. The honest test does not: Monet2$\leftrightarrow $Trippy stays inside its null band throughout the trial.\relax }}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:honest-biased}{{6}{6}{\textbf {V1 pairwise distance time courses: biased vs honest (Exp.~2).} Left panel: distances computed in the full neuron space (the honest test). Right panel: distances computed in the top-3 PC subspace fit on real-label trial averages (the biased test). Solid lines are observed pairwise distances per frame; shaded bands are bootstrap envelopes (B=1000); dashed horizontals are the 95\textsuperscript {th} percentile of the 100-shuffle null max distance per pair. The biased test puts every pair above its null. The honest test does not: Monet2$\leftrightarrow $Trippy stays inside its null band throughout the trial.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Population-size control on Monet2$\leftrightarrow $Trippy (Exp.~2).} Cross-area Monet2$\leftrightarrow $Trippy distance time course after subsampling V1, LM, RL to AL's 414 neurons (20 random draws, median $\pm $ IQR shown). Left: full-feature metric. Right: top-3 PC metric. V1's apparent lead in the raw comparison vanishes once neuron counts are equalised; all four areas converge to the same per-neuron band, confirming that V1's nominal advantage was a population-size effect rather than a per-neuron one.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:controls}{{7}{7}{\textbf {Population-size control on Monet2$\leftrightarrow $Trippy (Exp.~2).} Cross-area Monet2$\leftrightarrow $Trippy distance time course after subsampling V1, LM, RL to AL's 414 neurons (20 random draws, median $\pm $ IQR shown). Left: full-feature metric. Right: top-3 PC metric. V1's apparent lead in the raw comparison vanishes once neuron counts are equalised; all four areas converge to the same per-neuron band, confirming that V1's nominal advantage was a population-size effect rather than a per-neuron one.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Clip-category trajectories in PC1--PC2 space, per area (Exp.~3).} Same layout as Fig.~\ref {fig:pc-clusters} but coloured by Clip content sub-category (Cinematic, sports1m, Rendered) rather than by stimulus class. All three categories separate cleanly in every area and remain stationary within their own region of state space after the onset transient.\relax }}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:exp3-trajectories}{{8}{7}{\textbf {Clip-category trajectories in PC1--PC2 space, per area (Exp.~3).} Same layout as Fig.~\ref {fig:pc-clusters} but coloured by Clip content sub-category (Cinematic, sports1m, Rendered) rather than by stimulus class. All three categories separate cleanly in every area and remain stationary within their own region of state space after the onset transient.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Cross-area Clip-category distance time courses, all three pairs (Exp.~3).} Full-feature pairwise distance per frame, one panel per category pair (Cinematic$\leftrightarrow $sports1m, Cinematic$\leftrightarrow $Rendered, sports1m$\leftrightarrow $Rendered), with one coloured line per cortical area and bootstrap envelopes shaded. All four areas separate all three pairs at $p \le 0.02$; onset is at frame~2 ($\sim $267~ms post stimulus onset).\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:exp3-three-pairs}{{9}{8}{\textbf {Cross-area Clip-category distance time courses, all three pairs (Exp.~3).} Full-feature pairwise distance per frame, one panel per category pair (Cinematic$\leftrightarrow $sports1m, Cinematic$\leftrightarrow $Rendered, sports1m$\leftrightarrow $Rendered), with one coloured line per cortical area and bootstrap envelopes shaded. All four areas separate all three pairs at $p \le 0.02$; onset is at frame~2 ($\sim $267~ms post stimulus onset).\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Within-Clip sub-category distances after population matching (Exp.~3).} Same three pairs as Fig.~\ref {fig:exp3-three-pairs} but with every area subsampled to AL's 414 neurons (20 random draws, median $\pm $ IQR). Top row: full-feature metric. Bottom row: top-3 PC metric. AL leads on Cinematic$\leftrightarrow $Rendered and sports1m$\leftrightarrow $Rendered (the two natural-vs-synthetic contrasts) but collapses into the other areas on Cinematic$\leftrightarrow $sports1m (natural-vs-natural). The naturalness axis from Exp.~2 recurs within Clip.\relax }}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:al-naturalness}{{10}{8}{\textbf {Within-Clip sub-category distances after population matching (Exp.~3).} Same three pairs as Fig.~\ref {fig:exp3-three-pairs} but with every area subsampled to AL's 414 neurons (20 random draws, median $\pm $ IQR). Top row: full-feature metric. Bottom row: top-3 PC metric. AL leads on Cinematic$\leftrightarrow $Rendered and sports1m$\leftrightarrow $Rendered (the two natural-vs-synthetic contrasts) but collapses into the other areas on Cinematic$\leftrightarrow $sports1m (natural-vs-natural). The naturalness axis from Exp.~2 recurs within Clip.\relax }{figure.caption.12}{}}
