\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Honest-test $p$-values: maximum full-feature trajectory distance against the 100-shuffle null. Monet2$\leftrightarrow $Trippy never crosses the threshold in any area.\relax }}{3}{table.caption.2}\protected@file@percent }
