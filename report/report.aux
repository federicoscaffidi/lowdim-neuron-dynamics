\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Trial-averaged PSTH per stimulus class.} Mean population response across all neurons of session 7\_5, averaged within each stimulus class and plotted against trial time. Trippy sits highest, Clip intermediate (with an onset transient in the first few frames), Monet2 lowest. Class identity is already encoded in the first moment of population activity.\relax }}{3}{figure.caption.10}\protected@file@percent }
\newlabel{fig:psth}{{1}{3}{\textbf {Trial-averaged PSTH per stimulus class.} Mean population response across all neurons of session 7\_5, averaged within each stimulus class and plotted against trial time. Trippy sits highest, Clip intermediate (with an onset transient in the first few frames), Monet2 lowest. Class identity is already encoded in the first moment of population activity.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Trial-averaged trajectories in PC1--PC2 space, per area.} Four panels (V1, AL, LM, RL): three stationary, non-overlapping clusters per area. The frame-0 marker sits offset from each cluster's bulk, indicating a shared neutral starting point and a rapid jump to stimulus-specific addresses within the first few frames (the onset transient).\relax }}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:pc-clusters}{{2}{4}{\textbf {Trial-averaged trajectories in PC1--PC2 space, per area.} Four panels (V1, AL, LM, RL): three stationary, non-overlapping clusters per area. The frame-0 marker sits offset from each cluster's bulk, indicating a shared neutral starting point and a rapid jump to stimulus-specific addresses within the first few frames (the onset transient).\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Honest vs.\ biased distance curves (Exp.~2).} For each class pair: observed full-feature distance (solid) with bootstrap envelope (shaded), against the shuffle-null 95\textsuperscript  {th} percentile (dashed). The biased top-3-PC test sits comfortably above its null in every pair; the honest full-feature test does not, for Monet2$\leftrightarrow $Trippy in any area.\relax }}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:honest-biased}{{3}{4}{\textbf {Honest vs.\ biased distance curves (Exp.~2).} For each class pair: observed full-feature distance (solid) with bootstrap envelope (shaded), against the shuffle-null 95\textsuperscript {th} percentile (dashed). The biased top-3-PC test sits comfortably above its null in every pair; the honest full-feature test does not, for Monet2$\leftrightarrow $Trippy in any area.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Population-size control.} Maximum honest-test distance per area before and after matching every area to AL's 414 neurons (mean $\pm $ SD over 20 random draws). V1's apparent lead in the raw comparison disappears; all four areas collapse into the same narrow band on a per-neuron basis.\relax }}{4}{figure.caption.13}\protected@file@percent }
\newlabel{fig:controls}{{4}{4}{\textbf {Population-size control.} Maximum honest-test distance per area before and after matching every area to AL's 414 neurons (mean $\pm $ SD over 20 random draws). V1's apparent lead in the raw comparison disappears; all four areas collapse into the same narrow band on a per-neuron basis.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Within-Clip sub-category distances after population matching (Exp.~3).} AL leads on Cinematic$\leftrightarrow $Rendered and sports1m$\leftrightarrow $Rendered (both natural-vs-synthetic contrasts) but matches the other areas on Cinematic$\leftrightarrow $sports1m (natural-vs-natural). The naturalness axis recurs.\relax }}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:al-naturalness}{{5}{5}{\textbf {Within-Clip sub-category distances after population matching (Exp.~3).} AL leads on Cinematic$\leftrightarrow $Rendered and sports1m$\leftrightarrow $Rendered (both natural-vs-synthetic contrasts) but matches the other areas on Cinematic$\leftrightarrow $sports1m (natural-vs-natural). The naturalness axis recurs.\relax }{figure.caption.14}{}}
